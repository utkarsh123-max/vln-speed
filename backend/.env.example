# Port the measurement server listens on
PORT=4000

# Comma-separated list of allowed origins for CORS, e.g. https://vlnspeed.com,https://www.vlnspeed.com
# Use * only for local development.
CORS_ORIGIN=*

# Identity of this server node, shown in the UI's server selector.
SERVER_ID=del-01
SERVER_NAME=Delhi
SERVER_REGION=India
