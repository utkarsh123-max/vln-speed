# URL of your deployed backend (see /backend). For local dev, the default
# already points at http://localhost:4000, so this file is only needed
# once you deploy.
VITE_API_URL=http://localhost:4000

# Optional: JSON array of multiple regional servers. Leave unset until you
# have deployed the backend in more than one region. See src/config/servers.ts.
# VITE_SERVERS=[{"id":"del-01","name":"Delhi","region":"India","url":"https://del.vlnspeed.com"}]
